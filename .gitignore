# ============================================================
#  这个仓库只放「工具本身」，不放成品画册、不放私人照片
#  （仓库根 = photo-flipbook-tool/，成品画册在工作区上一层，
#    物理上就在仓库外面；下面这些是第二道保险）
# ============================================================

# ---- 成品画册：绝不上传 ----
画册集/
画册/
*.flipbook/

# ---- 用户自己的照片与素材 ----
图片/
深圳人文图集/
user-fonts/

# ---- 一次性探针、验收残留、运行输出 ----
.verify-probe/
.ui-probe/
.ui-shots/
_p*.mjs
_p*.log
_p*.txt
_p*.out.txt
_p*_stab_*.log
_probe_*
*.out.txt
*.readable.txt

# ---- 运行时产物 ----
__pycache__/
*.pyc
*.pyo
logs/
node_modules/
.venv/
venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
